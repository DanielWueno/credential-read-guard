# Ejemplo de .credentialguardignore -- copiar a la raiz del proyecto que se
# quiere proteger y renombrar quitando ".example". No es necesario crear
# este archivo para usar el plugin: sin el, solo aplican los patrones
# integrados en hooks/guard.js.
#
# Cada linea es un patron regex (insensible a mayusculas) que se agrega a
# los patrones integrados de nombres de archivo considerados credenciales.
# Prefijo "!" excluye un patron -- incluso uno integrado -- en vez de
# agregarlo. Prefijo "keyword:" agrega una palabra clave de busqueda de
# secretos en vez de un patron de archivo ("!keyword:" para excluirla).
# Prefijo "redact-key:" agrega una clave cuyo VALOR se redacta dentro de un
# archivo ya mostrado, sin bloquear el archivo entero ni ninguna busqueda
# ("!redact-key:" para excluir una clave que las reglas integradas
# redactarian igual). Lineas vacias o que empiezan con "#" se ignoran.
#
# La diferencia entre los tres importa: un patron de archivo (sin prefijo)
# o "keyword:" excluyen/incluyen ARCHIVOS o BUSQUEDAS enteras -- tiene
# sentido cuando lo que se agrega es un nombre, extension o patron de
# busqueda, porque ahi si se entiende que se trata "todo" como credencial.
# "redact-key:" es lo opuesto: solo tacha el VALOR de una clave puntual
# (p.ej. "Authority" en un appsettings.json) dejando visible el resto del
# archivo -- para eso no sirve un patron de archivo ni "keyword:", que
# bloquearian de mas (el archivo completo, o toda busqueda que mencione esa
# palabra) por una sola clave que no es en si misma un secreto.

# Agregar un archivo propio de configuracion sensible:
mi_configuracion_secreta\.ini$

# Agregar una palabra clave adicional para deteccion via Grep/grep-por-shell:
keyword: clave_maestra_interna

# Forzar la redaccion del VALOR de una clave puntual (no bloquea el archivo
# ni una busqueda) -- util para un campo tipo Authority/Endpoint que el
# proyecto SI considera sensible aunque su valor sea una URL (por diseno,
# las heuristicas integradas no redactan URLs para evitar falsos positivos):
redact-key: Authority

# Excluir una clave que las heuristicas integradas (Auth/Credential +
# entropia) redactarian y en este proyecto no corresponde:
!redact-key: AuthMode

# IPs o hostnames internos no vienen entre los patrones integrados -- una IP
# o un dominio aparece tambien en contextos legitimos (localhost, ejemplos en
# comentarios, la URL publica de una API), asi que un patron global de ese
# tipo generaria demasiados falsos positivos. Si un proyecto puntual quiere
# tratar su propio rango interno como busqueda de secretos, se agrega asi:
keyword: 10\.20\.
keyword: \.miempresa-interna\.local$

# Excluir un patron integrado que en este proyecto no aplica -- usar con
# cuidado, esto reduce la cobertura del plugin para el patron indicado:
!appsettings\.Test\.json$
