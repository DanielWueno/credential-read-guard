# Ejemplo de .credentialguardignore -- copiar a la raiz del proyecto que se
# quiere proteger y renombrar quitando ".example". No es necesario crear
# este archivo para usar el plugin: sin el, solo aplican los patrones
# integrados en hooks/guard.js.
#
# Cada linea es un patron regex (insensible a mayusculas) que se agrega a
# los patrones integrados de nombres de archivo considerados credenciales.
# Prefijo "!" excluye un patron -- incluso uno integrado -- en vez de
# agregarlo. Prefijo "keyword:" agrega una palabra clave de busqueda de
# secretos en vez de un patron de archivo ("!keyword:" para excluirla).
# Lineas vacias o que empiezan con "#" se ignoran.

# Agregar un archivo propio de configuracion sensible:
mi_configuracion_secreta\.ini$

# Agregar una palabra clave adicional para deteccion via Grep/grep-por-shell:
keyword: clave_maestra_interna

# IPs o hostnames internos no vienen entre los patrones integrados -- una IP
# o un dominio aparece tambien en contextos legitimos (localhost, ejemplos en
# comentarios, la URL publica de una API), asi que un patron global de ese
# tipo generaria demasiados falsos positivos. Si un proyecto puntual quiere
# tratar su propio rango interno como busqueda de secretos, se agrega asi:
keyword: 10\.20\.
keyword: \.miempresa-interna\.local$

# Excluir un patron integrado que en este proyecto no aplica -- usar con
# cuidado, esto reduce la cobertura del plugin para el patron indicado:
!appsettings\.Test\.json$
